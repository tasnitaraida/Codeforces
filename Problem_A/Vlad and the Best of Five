#include<stdio.h>
 
int main(void)
{
    int t;
    scanf("%d",&t);
    getchar();
 
    while(t--)
    {
        char c;
        char word[5];
        int i=0;
        int count=0;
 
        while((c=getchar())!='\n')
        {
            word[i++]=c;
        }
        word[i]!='\0';
 
        for(i=0;i<5;i++)
        {
            if(word[i]=='A')
            {
                count=count+1;
            }
        }
 
        if(count>=3)
        {
            printf("A\n");
        }
        else 
        {
            printf("B\n");
        }
    }
    return 0;
}
